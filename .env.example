# ============================================================================
# Enclave Development Environment
# ============================================================================

# Transport (set ENCLAVE_USE_VSOCK=true for Nitro production)
ENCLAVE_USE_VSOCK=false
ENCLAVE_VSOCK_PORT=5000
ENCLAVE_TCP_PORT=8765
ENCLAVE_TCP_HOST=127.0.0.1

# LLM Provider: "mock", "anthropic", "openai", "gemini", "ollama"
ENCLAVE_LLM_PROVIDER=mock
ENCLAVE_LLM_MODEL=claude-sonnet-4-20250514
# ENCLAVE_LLM_BASE_URL=http://localhost:9000  # Set if using the Go privacy proxy

# Provider API Keys (uncomment the one you're using)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...

# Ollama (local, no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# Workspace
ENCLAVE_WORKSPACE=/tmp/enclave_workspace
ENCLAVE_DB_PATH=/tmp/enclave_state.db
ENCLAVE_SEALED_PATH=/tmp/enclave_sealed

# Agent defaults
ENCLAVE_MAX_STEPS=50
ENCLAVE_TIMEOUT=300
ENCLAVE_BUDGET_USD=5.0

# Tool config (comma-separated domain allowlist; empty = allow all)
# ENCLAVE_DOMAIN_ALLOWLIST=api.github.com,pypi.org,registry.npmjs.org

# Go Privacy Proxy (for proxy/main.go)
# LLM_API_KEYS=sk-ant-key1,sk-ant-key2
# PROXY_CONFIG=proxy/config.json
